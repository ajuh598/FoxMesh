{
  "id": "trellis",
  "name": "TRELLIS",
  "version": "1.0",
  "adapter": "http",
  "description": "Microsoft TRELLIS structured-latent 3D generation via a FoxMesh inference server. Textured GLB output.",
  "tasks": ["generate_3d", "image_to_3d"],
  "inputs": ["text", "image"],
  "outputs": ["glb"],
  "runtime": "local_gpu",
  "vram_gb": 16,
  "est_runtime_s": 60,
  "quality": {"accuracy": 0.75, "mesh": 0.75, "texture": 0.75},
  "topology": "dense",
  "watertight": false,
  "produces_textures": true,
  "license": "MIT",
  "commercial_use": true,
  "enabled": false,
  "config": {"endpoint": null, "model": "trellis"}
}
